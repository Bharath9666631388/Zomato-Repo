pipeline {
    agent any
    environment {
        scannerHome=tool 'mysonar'
    }
    stages {
        stage ('cleanws') {
            steps {
                cleanWs()
            }
        }
        stage ('code') {
            steps {
                git branch: 'main', url: 'https://github.com/Bharath9666631388/Zomato-Repo.git'
            }
        }
        stage ('CQA') {
            steps {
                withSonarQubeEnv('mysonar') {
                    sh "${scannerHome}/bin/sonar-scanner -Dsonar.projectKey=zomato"
                }
            }
        }
        stage ('Quality gates') {
            steps{
                script {
                    waitForQualityGate abortPipeline: false, credentialsId: 'sonar-token'
                }
            }
        }
        stage ('Build') {
            steps {
                sh 'docker build -t zomatoimage .'
            }
        }
        stage ('Scan') {
            steps {
                sh 'trivy image zomatoimage'
            }
        }
        stage ('tag') {
            steps {
                sh 'docker tag zomatoimage bharathdammalapati/secondrepo:zomato'
            }
        }
        stage ('push') {
            steps {
                script {
                    withDockerRegistry(credentialsId: 'dockerhub') {
                       sh 'docker push bharathdammalapati/secondrepo:zomato'
                    }
                }       
            } 
        }
        stage ('Deploy') {
            steps {
                sh 'docker run -itd --name zomatocontainer -p:3000:3000 zomatoimage'
            }
        }
    }
}
